# Normalize to LF in the repository; check out native on Windows.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf

# Shell scripts MUST be LF: a CRLF shebang fails on POSIX with
# "bad interpreter: /usr/bin/env bash^M".
*.sh   text eol=lf

# PowerShell is Windows-native; CRLF is the least surprising there.
*.ps1  text eol=crlf

# Extensionless files that should still be LF.
LICENSE text eol=lf
